{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,
    "noFallthroughCasesInSwitch": true,
    "rootDir": "./server",
    "outDir": "./dist/server"
  },
  "include": ["server/index.mts", "server/promote-admin.mts"]
}
